<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vietvu.macos-disk-analyzer.snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/vietvu/works/github.com/vietvudanh/macos-disk-analyzer/scripts/run_daily_snapshot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vietvu/works/github.com/vietvudanh/macos-disk-analyzer</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Run every day at 02:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vietvu/works/github.com/vietvudanh/macos-disk-analyzer/data/snapshot.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vietvu/works/github.com/vietvudanh/macos-disk-analyzer/data/snapshot.log</string>

    <!-- Run with lower system priority to avoid impacting foreground usage -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
